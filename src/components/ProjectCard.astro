---
import ArrowIcon from './ArrowIcon.astro';
import ProjectCover from './ProjectCover.astro';
import type { Project } from '../data/site';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { title, meta, description, tags, cover, href, pending } = project;

const number = String(index + 1).padStart(2, '0');
const external = href?.startsWith('http');
---

<article class:list={['card', 'frame', { 'frame--muted': pending }]}>
  <div class="frame__body card__body">
    <div class="card__meta">
      <span>Proyecto {number}</span>
      <span>{meta}</span>
    </div>

    <ProjectCover kind={cover} />

    <h3>{title}</h3>
    <p class="card__desc">{description}</p>

    <ul class="card__tags">
      {tags.map((tag) => <li class:list={['tag', { 'tag--dim': pending }]}>{tag}</li>)}
    </ul>

    {
      pending ? (
        <span class="card__link card__link--dim">Próximamente</span>
      ) : (
        <a
          class="card__link"
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
        >
          Ver proyecto
          <ArrowIcon />
          <span class="sr-only">: {title}</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }

  .card__body {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .card__desc {
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-card);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag--dim {
    border-color: #4c6674;
    color: var(--text-off);
  }

  .card__link {
    align-self: flex-start;
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--warm);
  }

  .card__link--dim {
    color: var(--text-off);
  }

  /* Estado apagado del proyecto pendiente */
  .frame--muted h3 {
    color: var(--text-soft);
  }

  .frame--muted .card__desc {
    color: var(--text-off);
  }
</style>
