---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot__inner">
    <div class="foot__legal">
      <span class="foot__copy">© {year} {site.name}</span>
      <span class="foot__made">Hecho con Astro</span>
    </div>

    <div class="foot__coin" aria-hidden="true">
      <span class="foot__disc"></span>
      <span class="foot__text pixel blink">INSERT COIN TO CONTINUE</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--bg-deep);
    border-top: 4px solid var(--edge-glow);
  }

  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    min-height: 140px;
    padding-block: 32px;
  }

  .foot__legal {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .foot__copy {
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .foot__made {
    font-size: 15px;
    color: var(--dim);
  }

  .foot__coin {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .foot__disc {
    display: block;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--hot);
    box-shadow: inset -4px -4px 0 rgba(0, 0, 0, 0.25);
  }

  .foot__text {
    font-size: 12px;
    color: var(--hot);
  }
</style>
