---
import ArrowIcon from './ArrowIcon.astro';
import SectionHeading from './SectionHeading.astro';
import { socials } from '../data/site';
---

<section id="redes" class="socials">
  <div class="wrap">
    <SectionHeading kicker="03 — Contacto" title="Redes" />

    <ul class="socials__grid">
      {
        socials.map((social) => {
          const external = social.href.startsWith('http');
          return (
            <li>
              <a
                class="frame social"
                href={social.href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                <div class="frame__body social__body">
                  <div class:list={['social__badge', `social__badge--${social.tone}`]} aria-hidden="true">
                    {social.badge}
                  </div>
                  <div class="social__info">
                    <span class="social__name">{social.name}</span>
                    <span class="social__handle">{social.handle}</span>
                  </div>
                  <span class="social__cta">
                    Abrir perfil
                    <ArrowIcon />
                    <span class="sr-only"> de {social.name}</span>
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .socials {
    padding-block: 88px;
    background: var(--bg);
    border-top: 1px solid var(--line);
  }

  .socials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 32px;
    margin-top: 48px;
  }

  .social {
    color: var(--text);
  }

  .social__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 24px;
    min-height: 150px;
    padding: 24px 32px;
  }

  .social__badge {
    --cut: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 84px;
    height: 84px;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    clip-path: polygon(
      0 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% 100%,
      var(--cut) 100%,
      0 calc(100% - var(--cut))
    );
  }

  .social__badge--accent {
    background: var(--accent);
  }

  .social__badge--warm {
    background: var(--warm);
  }

  .social__info {
    flex: 1 1 180px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .social__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .social__handle {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--text-soft);
    overflow-wrap: anywhere;
  }

  .social__cta {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
  }

  @media (max-width: 720px) {
    .socials {
      padding-block: 64px;
    }
  }
</style>
