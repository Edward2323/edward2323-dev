---
const links = [
  { href: '#inicio', label: '01 Inicio' },
  { href: '#proyectos', label: '02 Proyectos' },
  { href: '#redes', label: '03 Redes' },
];
---

<header class="hud">
  <div class="wrap hud__inner">
    <a class="hud__logo" href="#inicio">
      <svg class="px" width="40" height="26" viewBox="0 0 20 13" aria-hidden="true">
        <rect x="3" y="1" width="14" height="2" class="f-accent"></rect>
        <rect x="1" y="3" width="18" height="7" class="f-accent"></rect>
        <rect x="1" y="10" width="3" height="2" class="f-accent"></rect>
        <rect x="16" y="10" width="3" height="2" class="f-accent"></rect>
        <rect x="5" y="4" width="1" height="3" class="f-ink"></rect>
        <rect x="4" y="5" width="3" height="1" class="f-ink"></rect>
        <rect x="13" y="4" width="2" height="2" class="f-ink"></rect>
        <rect x="15" y="6" width="2" height="2" class="f-ink"></rect>
      </svg>
      <span class="pixel">EDWARD.DEV</span>
    </a>

    <nav class="hud__nav" aria-label="Principal">
      {links.map((link) => <a class="hud__link" href={link.href}>{link.label}</a>)}
    </nav>

    <div class="hud__status pixel">
      <span class="hud__dot blink"></span>
      P1 ONLINE
    </div>
  </div>
</header>

<style>
  .hud {
    background: var(--bg-deep);
    border-bottom: 4px solid var(--edge-glow);
  }

  .hud__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: 76px;
  }

  .hud__logo {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 14px;
    color: var(--accent);
    text-decoration: none;
  }

  .hud__nav {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .hud__link {
    padding: 12px 16px;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: #c9d3ff;
  }

  .hud__link:hover {
    background: var(--panel);
  }

  .hud__status {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    background: var(--panel);
    border: 2px solid var(--edge-glow);
    font-size: 11px;
  }

  .hud__dot {
    display: block;
    width: 10px;
    height: 10px;
    background: var(--accent);
  }

  @media (max-width: 820px) {
    .hud__inner {
      flex-wrap: wrap;
      gap: 8px 16px;
      padding-block: 14px;
    }

    .hud__nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      justify-content: space-between;
    }

    .hud__link {
      padding: 10px 8px;
      font-size: 13px;
      letter-spacing: 0.06em;
    }

    .hud__status {
      margin-left: auto;
    }
  }

  @media (max-width: 480px) {
    .hud__status {
      display: none;
    }
  }
</style>
