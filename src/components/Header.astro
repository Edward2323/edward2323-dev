---
import { site } from '../data/site';

const links = [
  { href: '#inicio', label: '01 Inicio' },
  { href: '#proyectos', label: '02 Proyectos' },
  { href: '#redes', label: '03 Redes' },
];
---

<header class="bar">
  <div class="wrap bar__inner">
    <a class="bar__brand" href="#inicio">
      <span class="bar__mark" aria-hidden="true"></span>
      <span class="bar__name">{site.name}</span>
      <span class="bar__tag">/ Portafolio</span>
    </a>

    <nav class="bar__nav" aria-label="Principal">
      {links.map((link) => <a class="bar__link" href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .bar {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .bar__inner {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 68px;
  }

  .bar__brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }

  .bar__mark {
    display: block;
    width: 10px;
    height: 10px;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  .bar__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .bar__tag {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.14em;
    color: var(--text-dim);
  }

  .bar__nav {
    display: flex;
    align-items: center;
    gap: 40px;
    margin-left: auto;
  }

  .bar__link {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-soft);
  }

  .bar__link:hover {
    color: #ffffff;
  }

  @media (max-width: 720px) {
    .bar__inner {
      flex-wrap: wrap;
      gap: 4px 16px;
      padding-block: 12px;
    }

    .bar__tag {
      display: none;
    }

    .bar__nav {
      width: 100%;
      margin-left: 0;
      justify-content: space-between;
      gap: 12px;
    }

    .bar__link {
      padding-block: 8px;
      font-size: 13px;
      letter-spacing: 0.1em;
    }
  }
</style>
