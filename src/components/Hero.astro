---
import City from './City.astro';
import TechPanel from './TechPanel.astro';
import { site } from '../data/site';
---

<section id="inicio" class="hero">
  <div class="hero__haze"></div>
  <City />
  <div class="hero__rain"></div>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <div class="hero__kicker">
        <span class="hero__rule"></span>
        <span>Portafolio de proyectos</span>
      </div>

      <h1>{site.name}</h1>
      <p class="hero__role">{site.role}</p>
      <p class="hero__bio">{site.bio}</p>

      <div class="hero__cta">
        <a class="btn btn--solid" href="#proyectos">Ver proyectos</a>
        <a class="btn btn--outline" href="#redes">
          <span class="btn__inner">Ver redes</span>
        </a>
      </div>
    </div>

    <TechPanel />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #04070d 0%, #08202d 45%, #123a44 62%, #3a2a25 78%, #06090f 100%);
  }

  /* Neblina naranja en el horizonte, detrás de los edificios */
  .hero__haze {
    position: absolute;
    left: 50%;
    bottom: -20px;
    width: 1400px;
    height: 320px;
    margin-left: -700px;
    border-radius: 50%;
    background: rgba(255, 122, 31, 0.5);
    filter: blur(70px);
  }

  .hero__rain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(
        100deg,
        rgba(190, 230, 255, 0.09) 0,
        rgba(190, 230, 255, 0.09) 1px,
        transparent 1px,
        transparent 22px
      ),
      repeating-linear-gradient(
        100deg,
        rgba(190, 230, 255, 0.05) 0,
        rgba(190, 230, 255, 0.05) 1px,
        transparent 1px,
        transparent 9px
      );
  }

  .hero__inner {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 64px;
    padding-top: 96px;
    padding-bottom: 348px;
  }

  .hero__copy {
    flex: 1;
    min-width: 0;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hero__rule {
    display: block;
    width: 40px;
    height: 1px;
    background: var(--accent);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(44px, 7.8vw, 112px);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-strong);
    text-shadow:
      0 0 14px rgba(39, 225, 255, 0.7),
      0 0 44px rgba(39, 225, 255, 0.35);
  }

  .hero__role {
    font-weight: 600;
    font-size: clamp(18px, 1.8vw, 26px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--warm);
  }

  .hero__bio {
    max-width: 600px;
    font-size: 20px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 14px;
  }

  @media (max-width: 1080px) {
    .hero__inner {
      flex-direction: column;
      gap: 40px;
      padding-top: 56px;
      padding-bottom: 300px;
    }
  }
</style>
