---
import { site } from '../data/site';
---

<aside class="player panel" aria-label="Tarjeta de jugador">
  <div class="player__bar pixel">
    <span>PLAYER 1</span>
    <span>LISTO</span>
  </div>

  <div class="player__body">
    <div class="player__top">
      <div class="player__avatar">
        <svg class="px" width="96" height="96" viewBox="0 0 12 12" role="img" aria-label={`Avatar de ${site.name}`}>
          <rect x="5" y="0" width="2" height="1" class="f-hot"></rect>
          <rect x="5" y="1" width="2" height="1" class="f-steel"></rect>
          <rect x="2" y="2" width="8" height="6" class="f-steel"></rect>
          <rect x="1" y="4" width="1" height="2" class="f-edge"></rect>
          <rect x="10" y="4" width="1" height="2" class="f-edge"></rect>
          <rect x="3" y="4" width="6" height="2" class="f-ink"></rect>
          <rect x="4" y="4" width="1" height="2" class="f-accent"></rect>
          <rect x="7" y="4" width="1" height="2" class="f-accent"></rect>
          <rect x="4" y="7" width="4" height="1" class="f-edge"></rect>
          <rect x="3" y="9" width="6" height="3" class="f-blue"></rect>
          <rect x="5" y="10" width="2" height="1" class="f-hot"></rect>
        </svg>
      </div>

      <dl class="player__info">
        <div>
          <dt class="pixel">NOMBRE</dt>
          <dd class="player__name">{site.name}</dd>
        </div>
        <div>
          <dt class="pixel">CLASE</dt>
          <dd class="player__class">{site.playerClass}</dd>
        </div>
      </dl>
    </div>

    <div class="player__divider"></div>

    <div class="player__inventory">
      <span class="player__label pixel">INVENTARIO</span>
      <ul class="player__chips">
        {site.inventory.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</aside>

<style>
  .player {
    width: min(480px, 100%);
    flex-shrink: 0;
  }

  .player__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 18px;
    background: var(--accent);
    color: #04122a;
    font-size: 11px;
  }

  .player__body {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 24px;
  }

  .player__top {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .player__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 112px;
    height: 112px;
    background: var(--bg);
    border: 3px solid;
    border-color: var(--edge-dark) var(--edge-light) var(--edge-light) var(--edge-dark);
  }

  .player__info {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
  }

  .player__info div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  dt,
  .player__label {
    font-size: 10px;
    color: var(--dim);
  }

  dd {
    margin: 0;
  }

  .player__name {
    font-weight: 700;
    font-size: 26px;
    line-height: 1;
    text-transform: uppercase;
  }

  .player__class {
    font-weight: 600;
    font-size: 18px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--accent);
  }

  .player__divider {
    border-top: 3px dashed var(--edge-glow);
  }

  .player__inventory {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .player__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .player__chips li {
    padding: 8px 12px;
    background: var(--bg);
    border: 2px solid var(--chip-line);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
