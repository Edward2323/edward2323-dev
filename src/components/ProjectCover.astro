---
interface Props {
  kind: 'phone' | 'browser' | 'placeholder';
}

const { kind } = Astro.props;

// Teclas de la calculadora: 3 columnas x 4 filas. La última columna (operadores) va en naranja.
const rows = [98, 124, 150, 176];
---

<div class:list={['cover', { 'cover--pending': kind === 'placeholder' }]}>
  {kind !== 'placeholder' && <div class="cover__glow"></div>}

  <svg viewBox="0 0 384 240" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    {
      kind === 'phone' && (
        <>
          <g class="line line--accent">
            <rect x="142" y="24" width="100" height="192" rx="16" />
            <line x1="172" y1="36" x2="212" y2="36" />
            <rect x="156" y="52" width="72" height="32" rx="4" />
            {rows.map((y) => (
              <>
                <rect x="156" y={y} width="20" height="20" />
                <rect x="182" y={y} width="20" height="20" />
              </>
            ))}
          </g>
          <g class="line line--warm">
            {rows.map((y) => (
              <rect x="208" y={y} width="20" height="20" />
            ))}
          </g>
        </>
      )
    }
    {
      kind === 'browser' && (
        <>
          <g class="line line--warm">
            <rect x="72" y="40" width="240" height="160" rx="8" />
            <line x1="72" y1="68" x2="312" y2="68" />
            <circle cx="90" cy="54" r="4" />
            <circle cx="104" cy="54" r="4" />
            <circle cx="118" cy="54" r="4" />
          </g>
          <g class="line line--accent">
            <rect x="92" y="88" width="100" height="14" />
            <line x1="92" y1="120" x2="190" y2="120" />
            <line x1="92" y1="136" x2="190" y2="136" />
            <line x1="92" y1="152" x2="160" y2="152" />
            <rect x="210" y="88" width="82" height="58" />
            <rect x="92" y="168" width="60" height="18" />
          </g>
        </>
      )
    }
    {
      kind === 'placeholder' && (
        <>
          <g class="line line--dim line--dash">
            <rect x="132" y="54" width="120" height="132" rx="10" />
          </g>
          <g class="line line--dim">
            <line x1="192" y1="100" x2="192" y2="140" />
            <line x1="172" y1="120" x2="212" y2="120" />
          </g>
        </>
      )
    }
  </svg>
</div>

<style>
  .cover {
    position: relative;
    height: 240px;
    overflow: hidden;
    background: linear-gradient(180deg, #09131d 0%, #0d2a36 100%);
    border: 1px solid rgba(39, 225, 255, 0.18);
  }

  .cover--pending {
    background: linear-gradient(180deg, #09131d 0%, #0b1d29 100%);
    border-color: rgba(39, 225, 255, 0.12);
  }

  .cover__glow {
    position: absolute;
    left: 50%;
    top: 45%;
    width: 240px;
    height: 120px;
    margin-left: -120px;
    background: rgba(255, 122, 31, 0.25);
    filter: blur(40px);
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .line {
    fill: none;
    stroke-width: 2;
  }

  .line--accent {
    stroke: var(--accent);
    filter: drop-shadow(0 0 6px var(--accent));
  }

  .line--warm {
    stroke: var(--warm);
    filter: drop-shadow(0 0 6px var(--warm));
  }

  .line--dim {
    stroke: #4c6674;
  }

  .line--dash {
    stroke-dasharray: 6 6;
  }
</style>
