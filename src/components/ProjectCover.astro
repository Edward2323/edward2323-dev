---
interface Props {
  kind: 'calculator' | 'browser' | 'lock';
}

const { kind } = Astro.props;

const keyRows = [8, 11, 14, 17];
---

<svg class="px cover" viewBox="0 0 32 22" aria-hidden="true">
  {
    kind === 'calculator' && (
      <>
        <rect x="9" y="1" width="12" height="20" class="f-steel" />
        <rect x="11" y="3" width="8" height="3" class="f-ink" />
        <rect x="17" y="4" width="2" height="1" class="f-accent" />
        {keyRows.map((y) => (
          <>
            <rect x="11" y={y} width="2" height="2" class="f-blue" />
            <rect x="14" y={y} width="2" height="2" class="f-blue" />
            <rect x="17" y={y} width="2" height="2" class="f-hot" />
          </>
        ))}
        <rect x="26" y="4" width="1" height="1" class="f-cherry" />
        <rect x="25" y="6" width="3" height="1" class="f-pink" />
        <rect x="24" y="7" width="5" height="1" class="f-pink" />
        <rect x="23" y="8" width="7" height="2" class="f-pink" />
        <rect x="24" y="10" width="5" height="4" class="f-hot" />
        <rect x="25" y="10" width="1" height="4" class="f-crust" />
        <rect x="27" y="10" width="1" height="4" class="f-crust" />
        <rect x="4" y="5" width="1" height="3" class="f-accent" />
        <rect x="3" y="6" width="3" height="1" class="f-accent" />
        <rect x="27" y="17" width="1" height="1" class="f-accent" />
      </>
    )
  }
  {
    kind === 'browser' && (
      <>
        <rect x="4" y="2" width="24" height="18" class="f-steel" />
        <rect x="4" y="2" width="24" height="3" class="f-accent" />
        <rect x="5" y="3" width="1" height="1" class="f-ink" />
        <rect x="7" y="3" width="1" height="1" class="f-ink" />
        <rect x="9" y="3" width="1" height="1" class="f-ink" />
        <rect x="6" y="6" width="20" height="12" class="f-ink" />
        <rect x="8" y="8" width="8" height="1" class="f-hot" />
        <rect x="8" y="10" width="14" height="1" class="f-accent" />
        <rect x="8" y="12" width="11" height="1" class="f-blue" />
        <rect x="8" y="14" width="7" height="1" class="f-blue" />
        <rect x="20" y="13" width="4" height="3" class="f-hot" />
      </>
    )
  }
  {
    kind === 'lock' && (
      <>
        <rect x="12" y="2" width="8" height="2" class="f-lock" />
        <rect x="11" y="4" width="2" height="5" class="f-lock" />
        <rect x="19" y="4" width="2" height="5" class="f-lock" />
        <rect x="8" y="9" width="16" height="11" class="f-lock" />
        <rect x="15" y="12" width="2" height="2" class="f-ink" />
        <rect x="15" y="14" width="2" height="3" class="f-ink" />
      </>
    )
  }
</svg>

<style>
  .cover {
    width: min(256px, 80%);
    height: auto;
  }
</style>
